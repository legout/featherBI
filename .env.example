# featherBI authoring credentials for remote S3-compatible sources (auth: s3).
# Copy to `.env` at the repository or project root; `.env` is gitignored and
# never copied into profiles, configs, HTML, or ZIPs. Values may also come
# from the process environment. featherBI tries the AWS credential chain
# (environment, profiles, SSO) first and uses these values as the fallback.
# Plain-HTTPS remote sources (auth: none) need no credentials.

# Required for auth: s3
FTHR_S3_KEY_ID=
FTHR_S3_SECRET=

# Optional
FTHR_S3_SESSION_TOKEN=
FTHR_S3_REGION=
# S3-compatible endpoints: hostname[:port] without scheme, e.g. 127.0.0.1:9000
FTHR_S3_ENDPOINT=
# Default true; set false for plain-HTTP endpoints
FTHR_S3_USE_SSL=
