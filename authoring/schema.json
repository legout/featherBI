{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://featherbi.dev/schemas/dashboard-project-v1.json",
  "title": "featherBI dashboard project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "title",
    "sources",
    "filters",
    "queries",
    "layout"
  ],
  "properties": {
    "project": {
      "const": 1
    },
    "title": {
      "$ref": "#/definitions/plainText"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/filter"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relationship"
      }
    },
    "queries": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/projectQuery"
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/component"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "columnName": {
      "type": "string",
      "minLength": 1
    },
    "bindingField": {
      "type": "string",
      "minLength": 1
    },
    "columnType": {
      "enum": [
        "string",
        "boolean",
        "integer",
        "number",
        "date",
        "timestamp"
      ]
    },
    "file": {
      "type": "string",
      "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "sourceSchema": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "nullable"
        ],
        "properties": {
          "type": {
            "$ref": "#/definitions/columnType"
          },
          "nullable": {
            "type": "boolean"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "file",
        "schema"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "csv",
            "parquet",
            "json"
          ]
        },
        "file": {
          "$ref": "#/definitions/file"
        },
        "schema": {
          "$ref": "#/definitions/sourceSchema"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "sources"
      ],
      "properties": {
        "mode": {
          "const": "upload"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "column",
        "default"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "enum": [
            "select",
            "text",
            "date-range"
          ]
        },
        "source": {
          "$ref": "#/definitions/id"
        },
        "column": {
          "$ref": "#/definitions/columnName"
        },
        "default": {}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sql",
        "params"
      ],
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "type",
        "query",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "kpi",
            "bar",
            "line",
            "heatmap",
            "table"
          ]
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "kpi"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/kpiComponent"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/barComponent"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "line"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/lineComponent"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heatmap"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/heatmapComponent"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/tableComponent"
          }
        }
      ]
    },
    "kpiComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "field"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "kpi"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "field": {
          "$ref": "#/definitions/bindingField"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "barComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "bar"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "x": {
          "$ref": "#/definitions/bindingField"
        },
        "y": {
          "$ref": "#/definitions/bindingField"
        },
        "series": {
          "$ref": "#/definitions/bindingField"
        },
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        }
      }
    },
    "lineComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "line"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "x": {
          "$ref": "#/definitions/bindingField"
        },
        "y": {
          "$ref": "#/definitions/bindingField"
        },
        "series": {
          "$ref": "#/definitions/bindingField"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        }
      }
    },
    "heatmapComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "x",
        "y",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "heatmap"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "x": {
          "$ref": "#/definitions/bindingField"
        },
        "y": {
          "$ref": "#/definitions/bindingField"
        },
        "value": {
          "$ref": "#/definitions/bindingField"
        }
      }
    },
    "tableComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "columns"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "table"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "label"
            ],
            "properties": {
              "field": {
                "$ref": "#/definitions/bindingField"
              },
              "label": {
                "$ref": "#/definitions/plainText"
              }
            }
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "label"
        ],
        "properties": {
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "label": {
            "$ref": "#/definitions/plainText"
          }
        }
      }
    },
    "projectQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sql",
        "params"
      ],
      "properties": {
        "sql": {
          "type": "string",
          "pattern": "^queries/[a-z][a-z0-9_]*\\.sql$"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right",
        "leftKey",
        "rightKey",
        "cardinality",
        "confirmed"
      ],
      "properties": {
        "left": {
          "$ref": "#/definitions/id"
        },
        "right": {
          "$ref": "#/definitions/id"
        },
        "leftKey": {
          "$ref": "#/definitions/columnName"
        },
        "rightKey": {
          "$ref": "#/definitions/columnName"
        },
        "cardinality": {
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-one",
            "many-to-many"
          ]
        },
        "confirmed": {
          "const": true
        }
      }
    }
  }
}
