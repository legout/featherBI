{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://featherbi.dev/schemas/dashboard-project-v1.json",
  "title": "featherBI dashboard project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "title",
    "sources",
    "filters",
    "queries",
    "layout"
  ],
  "properties": {
    "project": {
      "const": 1
    },
    "title": {
      "$ref": "#/definitions/plainText"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/filter"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relationship"
      }
    },
    "queries": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sql",
              "params"
            ],
            "properties": {
              "sql": {
                "type": "string",
                "pattern": "^queries/[a-z][a-z0-9_]*\\.sql$"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "measures"
            ],
            "properties": {
              "model": {
                "$ref": "#/definitions/id"
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/id"
                },
                "uniqueItems": true
              },
              "measures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/id"
                },
                "uniqueItems": true
              },
              "filters": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/id"
                },
                "uniqueItems": true
              },
              "orderBy": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/id"
                },
                "uniqueItems": true
              }
            }
          }
        ]
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "theme": {
      "enum": [
        "neutral",
        "daisyui",
        "siemens-ix"
      ],
      "default": "neutral"
    },
    "themeCss": {
      "type": "string",
      "pattern": "^theme\\.css$"
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sql",
          "schema"
        ],
        "properties": {
          "sql": {
            "type": "string",
            "pattern": "^models/[a-z][a-z0-9_]*\\.sql$"
          },
          "schema": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "nullable"
              ],
              "properties": {
                "type": {
                  "$ref": "#/definitions/columnType"
                },
                "nullable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "field",
          "label"
        ],
        "properties": {
          "model": {
            "$ref": "#/definitions/id"
          },
          "field": {
            "$ref": "#/definitions/bindingField"
          },
          "label": {
            "$ref": "#/definitions/plainText"
          },
          "description": {
            "$ref": "#/definitions/plainText"
          },
          "format": {
            "$ref": "#/definitions/plainText"
          }
        }
      }
    },
    "measures": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "aggregation",
              "label",
              "empty"
            ],
            "properties": {
              "model": {
                "$ref": "#/definitions/id"
              },
              "aggregation": {
                "enum": [
                  "count",
                  "distinct-count",
                  "sum",
                  "min",
                  "max",
                  "average"
                ]
              },
              "field": {
                "$ref": "#/definitions/bindingField"
              },
              "label": {
                "$ref": "#/definitions/plainText"
              },
              "format": {
                "$ref": "#/definitions/plainText"
              },
              "empty": {
                "enum": [
                  "null",
                  "zero"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "ratio",
              "label",
              "empty",
              "zero"
            ],
            "properties": {
              "model": {
                "$ref": "#/definitions/id"
              },
              "ratio": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "numerator",
                  "denominator"
                ],
                "properties": {
                  "numerator": {
                    "$ref": "#/definitions/id"
                  },
                  "denominator": {
                    "$ref": "#/definitions/id"
                  }
                }
              },
              "label": {
                "$ref": "#/definitions/plainText"
              },
              "format": {
                "$ref": "#/definitions/plainText"
              },
              "empty": {
                "enum": [
                  "null",
                  "zero"
                ]
              },
              "zero": {
                "enum": [
                  "null",
                  "zero"
                ]
              }
            }
          }
        ]
      }
    },
    "rendererPreset": {
      "enum": [
        "standard",
        "perspective-first"
      ],
      "default": "standard"
    },
    "playground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer"
      ],
      "properties": {
        "renderer": {
          "enum": [
            "ag-grid",
            "perspective"
          ]
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "columnName": {
      "type": "string",
      "minLength": 1
    },
    "bindingField": {
      "type": "string",
      "minLength": 1
    },
    "columnType": {
      "enum": [
        "string",
        "boolean",
        "integer",
        "number",
        "date",
        "timestamp"
      ]
    },
    "file": {
      "type": "string",
      "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "sourceSchema": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "nullable"
        ],
        "properties": {
          "type": {
            "$ref": "#/definitions/columnType"
          },
          "nullable": {
            "type": "boolean"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "csv",
            "parquet",
            "json"
          ]
        },
        "file": {
          "$ref": "#/definitions/file"
        },
        "schema": {
          "$ref": "#/definitions/sourceSchema"
        },
        "remote": {
          "$ref": "#/definitions/remoteSource"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "remote"
            ]
          },
          "then": {
            "properties": {
              "type": false,
              "file": false
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "remote"
              ]
            }
          },
          "then": {
            "required": [
              "type",
              "file"
            ]
          }
        }
      ]
    },
    "remoteSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "format",
        "auth"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^(?:s3|https)://[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]+$"
        },
        "format": {
          "enum": [
            "csv",
            "parquet",
            "json"
          ]
        },
        "auth": {
          "enum": [
            "none",
            "s3"
          ]
        },
        "region": {
          "$ref": "#/definitions/plainText"
        },
        "endpoint": {
          "$ref": "#/definitions/plainText"
        },
        "filename": {
          "$ref": "#/definitions/file"
        },
        "delivery": {
          "enum": [
            "packaged",
            "live"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "sources"
      ],
      "properties": {
        "mode": {
          "const": "upload"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "column",
        "default"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "enum": [
            "select",
            "single-select",
            "multi-select",
            "text",
            "date-range",
            "numeric-range",
            "boolean",
            "option-search"
          ]
        },
        "source": {
          "$ref": "#/definitions/id"
        },
        "column": {
          "$ref": "#/definitions/columnName"
        },
        "dimension": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "default": {},
        "search": {
          "type": "boolean"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sql",
        "params"
      ],
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "heading",
            "markdown",
            "text",
            "divider",
            "tabs",
            "section",
            "kpi",
            "metric-group",
            "bar",
            "line",
            "area",
            "scatter",
            "pie",
            "donut",
            "heatmap",
            "treemap",
            "sankey",
            "gauge",
            "boxplot",
            "table",
            "perspective"
          ]
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "x": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "y": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "field": {
          "$ref": "#/definitions/bindingField"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/bindingField"
          }
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "content": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "label": {
                "$ref": "#/definitions/plainText"
              },
              "components": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/id"
                }
              }
            }
          }
        },
        "xField": {
          "$ref": "#/definitions/bindingField"
        },
        "yField": {
          "$ref": "#/definitions/bindingField"
        },
        "value": {
          "$ref": "#/definitions/bindingField"
        },
        "name": {
          "$ref": "#/definitions/bindingField"
        },
        "series": {
          "$ref": "#/definitions/bindingField"
        },
        "source": {
          "$ref": "#/definitions/bindingField"
        },
        "target": {
          "$ref": "#/definitions/bindingField"
        },
        "min": {
          "$ref": "#/definitions/bindingField"
        },
        "max": {
          "$ref": "#/definitions/bindingField"
        },
        "q1": {
          "$ref": "#/definitions/bindingField"
        },
        "median": {
          "$ref": "#/definitions/bindingField"
        },
        "q3": {
          "$ref": "#/definitions/bindingField"
        },
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "stacked": {
          "type": "boolean"
        },
        "smooth": {
          "type": "boolean"
        },
        "legend": {
          "type": "boolean"
        },
        "interactionDimension": {
          "$ref": "#/definitions/id"
        },
        "selectionDimensions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/bindingField"
          },
          "additionalProperties": {
            "$ref": "#/definitions/id"
          }
        },
        "brushDimension": {
          "$ref": "#/definitions/id"
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "openTab": {
              "$ref": "#/definitions/id"
            },
            "drilldown": {
              "$ref": "#/definitions/id"
            }
          },
          "minProperties": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "label"
            ],
            "properties": {
              "field": {
                "$ref": "#/definitions/bindingField"
              },
              "label": {
                "$ref": "#/definitions/plainText"
              },
              "dimension": {
                "$ref": "#/definitions/id"
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "openTab": {
                    "$ref": "#/definitions/id"
                  },
                  "drilldown": {
                    "$ref": "#/definitions/id"
                  }
                },
                "minProperties": 1
              }
            }
          }
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "empty": {
          "enum": [
            "message",
            "hide",
            "zero"
          ]
        },
        "perspective": {
          "$ref": "#/definitions/perspectiveConfig"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "kpi",
                  "metric-group",
                  "bar",
                  "line",
                  "area",
                  "scatter",
                  "pie",
                  "donut",
                  "heatmap",
                  "treemap",
                  "sankey",
                  "gauge",
                  "boxplot",
                  "table",
                  "perspective"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "query"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "kpi"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "metric-group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "bar",
                  "line",
                  "area",
                  "scatter"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "xField",
              "yField"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "pie",
                  "donut",
                  "treemap"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "name",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heatmap"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "xField",
              "yField",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sankey"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "source",
              "target",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gauge"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boxplot"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "xField",
              "min",
              "q1",
              "median",
              "q3",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "columns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "heading",
                  "markdown",
                  "text"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "content"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "perspective"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "perspective"
            ]
          }
        }
      ]
    },
    "kpiComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "field"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "kpi"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "field": {
          "$ref": "#/definitions/bindingField"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "barComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "bar"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "x": {
          "$ref": "#/definitions/bindingField"
        },
        "y": {
          "$ref": "#/definitions/bindingField"
        },
        "series": {
          "$ref": "#/definitions/bindingField"
        },
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        }
      }
    },
    "lineComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
        "label",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "const": "line"
        },
        "query": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/plainText"
        },
        "x": {
          "$ref": "#/definitions/bindingField"
        },
        "y": {
          "$ref": "#/definitions/bindingField"
        },
        "series": {
          "$ref": "#/definitions/bindingField"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        }
      }
    },
    "heatmapComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "query",
