{
  "name": "featherbi",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "bin/",
    "authoring/",
    "packager/",
    "contract/",
    "scripts/",
    "runtime/",
    "skill/",
    "shells/",
    ".generated/",
    "README.md",
    "LICENSE",
    ".env.example",
    "!skill/featherbi/scripts/__pycache__"
  ],
  "description": "Contract-first serverless BI dashboards: runtime config contract validator",
  "bin": {
    "featherbi": "bin/featherbi.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/build-contract.mjs",
    "generate:contract": "node scripts/build-contract.mjs",
    "fixtures": "uv run tests/fixtures/generate.py",
    "build": "npm run generate:contract && node scripts/build.mjs",
    "build:harness": "npm run generate:contract && npm run fixtures && node scripts/build-test-harness.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "npm run build:harness && playwright test --project=chrome --grep-invert @private",
    "check": "npm run generate:contract && npm run fixtures && npm run test:unit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@duckdb/duckdb-wasm": "1.33.1-dev64.0",
    "@finos/perspective": "3.8.0",
    "@finos/perspective-viewer": "3.8.0",
    "@finos/perspective-viewer-d3fc": "3.8.0",
    "@finos/perspective-viewer-datagrid": "3.8.0",
    "@siemens/ix": "5.2.1",
    "@tailwindcss/cli": "4.3.3",
    "ag-grid-community": "35.3.1",
    "ajv": "8.20.0",
    "apache-arrow": "17.0.0",
    "client-zip": "2.5.1",
    "daisyui": "5.2.1",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "postcss-prefix-selector": "2.1.1",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "@finos/perspective-viewer-d3fc": {
      "d3-svg-legend": {
        "d3-color": "3.1.0"
      }
    }
  }
}
