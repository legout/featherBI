{
  "columns": [
    "x",
    "y"
  ],
  "optional": [
    "series"
  ],
  "click": [
    "x"
  ],
  "option": {
    "tooltip": {
      "trigger": "axis"
    },
    "legend": {},
    "grid": {},
    "xAxis": {
      "type": "category",
      "data": "@uniq:x"
    },
    "yAxis": {
      "type": "value"
    },
    "dataset": {
      "dimensions": [
        "x",
        "y"
      ],
      "source": "@rows"
    },
    "series": [
      {
        "encode": {
          "x": "x",
          "y": "y"
        },
        "type": "line",
        "symbolSize": 7,
        "areaStyle": {
          "opacity": 0.2
        }
      }
    ]
  }
}
