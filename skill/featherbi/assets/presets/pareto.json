{
  "columns": [
    "x",
    "y"
  ],
  "optional": [],
  "click": [
    "x"
  ],
  "option": {
    "tooltip": {
      "trigger": "axis",
      "axisPointer": {
        "type": "shadow"
      }
    },
    "grid": {},
    "xAxis": {
      "type": "category"
    },
    "yAxis": [
      {
        "type": "value"
      },
      {
        "type": "value",
        "min": 0,
        "max": 100,
        "axisLabel": {
          "formatter": "{value} %"
        },
        "splitLine": {
          "show": false
        }
      }
    ],
    "dataset": {
      "source": "@pareto"
    },
    "series": [
      {
        "type": "bar",
        "barMaxWidth": 48,
        "encode": {
          "x": "x",
          "y": "y"
        }
      },
      {
        "type": "line",
        "name": "Cumulative %",
        "yAxisIndex": 1,
        "symbol": "circle",
        "symbolSize": 8,
        "encode": {
          "x": "x",
          "y": "share"
        }
      }
    ]
  }
}
