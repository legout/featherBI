{
  "columns": [
    "x",
    "y",
    "series"
  ],
  "optional": [],
  "click": [
    "x"
  ],
  "option": {
    "tooltip": {
      "trigger": "axis",
      "axisPointer": {
        "type": "shadow"
      }
    },
    "legend": {},
    "grid": {},
    "xAxis": {
      "type": "category",
      "data": "@uniq:x"
    },
    "yAxis": {
      "type": "value"
    },
    "dataset": {
      "dimensions": [
        "x",
        "y"
      ],
      "source": "@rows"
    },
    "series": [
      {
        "encode": {
          "x": "x",
          "y": "y"
        },
        "type": "bar",
        "stack": "total",
        "barMaxWidth": 48
      }
    ]
  }
}
