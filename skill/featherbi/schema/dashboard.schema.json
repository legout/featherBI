{
  "type": "object",
  "required": ["title", "sources"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "engine": { "enum": ["haybarn", "duckdb-wasm"] },
    "design": { "enum": ["classic-bi", "market-desk", "timetable-board", "visible-grid"] },
    "theme": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "maxLength": 200 },
    "source_label": { "type": "string", "maxLength": 200 },
    "sources": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object" } },
    "dims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["col"],
        "additionalProperties": false,
        "properties": { "col": { "type": "string" }, "cols": { "type": "object", "additionalProperties": { "type": "string" } } }
      }
    },
    "date": {
      "type": "object",
      "required": ["col"],
      "additionalProperties": false,
      "properties": {
        "col": { "type": "string" },
        "cols": { "type": "object", "additionalProperties": { "type": "string" } },
        "default": { "type": ["string", "object"] }
      }
    },
    "explore": { "type": ["boolean", "object"], "additionalProperties": false, "properties": { "table": { "type": "string" } } },
    "layout": { "enum": ["stack", "tabs"] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "tiles"],
        "additionalProperties": false,
        "properties": { "title": { "type": "string", "minLength": 1 }, "tiles": { "$ref": "#/properties/tiles" } }
      }
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "size": { "enum": ["small", "medium", "large", "wide"] },
          "note": { "type": "string", "maxLength": 200 },
          "sql": { "type": "string" },
          "format": {
            "type": ["string", "object"],
            "additionalProperties": false,
            "properties": {
              "style": { "enum": ["number", "currency", "percent"] },
              "decimals": { "type": "number" },
              "currency": { "type": "string", "pattern": "^[A-Za-z]{3}$" },
              "unit": { "type": "string" }
            }
          },
          "click": { "type": ["string", "array"], "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
