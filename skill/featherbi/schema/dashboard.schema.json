{
  "type": "object",
  "required": ["title", "sources", "tiles"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "engine": { "enum": ["haybarn", "duckdb-wasm"] },
    "theme": { "type": "string", "minLength": 1 },
    "sources": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object" } },
    "dims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["col"],
        "additionalProperties": false,
        "properties": { "col": { "type": "string" }, "cols": { "type": "object", "additionalProperties": { "type": "string" } } }
      }
    },
    "date": {
      "type": "object",
      "required": ["col"],
      "additionalProperties": false,
      "properties": {
        "col": { "type": "string" },
        "cols": { "type": "object", "additionalProperties": { "type": "string" } },
        "default": { "type": ["string", "object"] }
      }
    },
    "explore": { "type": ["boolean", "object"], "additionalProperties": false, "properties": { "table": { "type": "string" } } },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "sql": { "type": "string" },
          "exclude": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
